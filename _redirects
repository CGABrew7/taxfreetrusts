# 301 each .html URL to its extensionless twin.
# Index files have their own rules so /index.html lands on / and
# /states/index.html lands on /states/, not /index or /states/index.
# Do not 200-rewrite a clean path back to the .html file. Pages already
# serves that file from the clean URL, and the rewrite loops.
/index.html / 301
/states/index.html /states/ 301
/*.html /:splat 301
